{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "nexprime-ui": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "np",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "**/*.svg",
                "input": "src/stories/icons/svg",
                "output": "icons"
              },
              {
                "glob": "**/*.json",
                "input": "src/stories/nexlottie/files",
                "output": "lottie"
              }
            ],
            "styles": [
              "src/styles.css"
            ],
            "server": "src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": [
                "localhost",
                "127.0.0.1"
              ]
            },
            "ssr": {
              "entry": "src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "10kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "nexprime-ui:build:production"
            },
            "development": {
              "buildTarget": "nexprime-ui:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        },
        "storybook": {
          "builder": "@storybook/angular-vite:start-storybook",
          "options": {
            "configDir": ".storybook",
            "browserTarget": "nexprime-ui:build",
            "port": 6006
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular-vite:build-storybook",
          "options": {
            "configDir": ".storybook",
            "browserTarget": "nexprime-ui:build",
            "outputDir": "storybook-static"
          }
        },
        "build-elements": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/nexprime-elements",
            "browser": "src/elements/nexprime.ts",
            "index": false,
            "tsConfig": "tsconfig.elements.json",
            "styles": [
              "src/stories/styles/theme.css"
            ],
            "assets": [
              {
                "glob": "**/*.svg",
                "input": "src/stories/icons/svg",
                "output": "icons"
              },
              {
                "glob": "**/*.json",
                "input": "src/stories/nexlottie/files",
                "output": "lottie"
              }
            ],
            "outputHashing": "none",
            "budgets": [
              {
                "type": "initial",
                "maximumWarning": "1mb",
                "maximumError": "2mb"
              }
            ]
          }
        }
      }
    },
    "nexprime-lib": {
      "projectType": "library",
      "root": "src",
      "sourceRoot": "src",
      "prefix": "np",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "src/ng-package.json",
            "tsConfig": "tsconfig.lib.json"
          }
        }
      }
    }
  }
}
