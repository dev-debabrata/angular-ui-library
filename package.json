{
  "name": "angular-ui-library",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "site-data": "node scripts/site-data.mjs",
    "prestart": "npm run site-data",
    "start": "ng serve",
    "prebuild": "npm run site-data",
    "build": "ng build && npm run build-storybook && node scripts/postbuild.mjs",
    "prewatch": "npm run site-data",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "storybook": "ng run angular-ui-library:storybook",
    "build-storybook": "ng run angular-ui-library:build-storybook",
    "build:elements": "ng run angular-ui-library:build-elements && node -e \"require('fs').renameSync('dist/nexui-elements/browser/main.js', 'dist/nexui-elements/browser/nexui.js')\"",
    "build:lib": "ng build nexui",
    "serve:ssr:angular-ui-library": "node dist/angular-ui-library/server/server.mjs"
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@angular/cdk": "~21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/elements": "^21.2.24",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.24",
    "express": "^5.1.0",
    "fflate": "^0.8.3",
    "lottie-web": "^5.13.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.5.2",
    "@angular-devkit/architect": "^0.2102.0",
    "@angular-devkit/build-angular": "^21.2.0",
    "@angular-devkit/core": "^21.2.0",
    "@angular/animations": "^21.2.0",
    "@angular/build": "^21.2.13",
    "@angular/cli": "^21.2.13",
    "@angular/compiler-cli": "^21.2.0",
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-onboarding": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/angular-vite": "^10.6.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "gifenc": "^1.0.3",
    "jsdom": "^28.0.0",
    "mediabunny": "^1.61.0",
    "ng-packagr": "^21.2.7",
    "playwright": "latest",
    "prettier": "^3.8.1",
    "storybook": "^10.6.0",
    "typescript": "~5.9.2",
    "vite": "latest",
    "vitest": "^4.0.8"
  }
}
