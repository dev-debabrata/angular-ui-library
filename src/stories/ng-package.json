{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/nexui",
  "lib": {
    "entryFile": "public-api.ts"
  },
  "allowedNonPeerDependencies": ["fflate", "lottie-web"],
  "assets": [
    "README.md",
    {
      "input": "styles",
      "glob": "{theme,animations}.css",
      "output": "styles"
    },
    {
      "input": "icons/svg",
      "glob": "*.svg",
      "output": "icons"
    },
    {
      "input": "icons/svg",
      "glob": "LICENSE-lucide.txt",
      "output": "icons"
    }
  ]
}
