{
  "name": "nexprime",
  "version": "0.1.2",
  "description": "NexPrime: one premium UI system for every framework. 85+ components for Angular and, as Web Components, for React, Next.js, Vue, Svelte and plain HTML: forms, tables, charts, dialogs, menus, chat, onboarding tours, background effects, a Lottie player, 2,000+ icons, CSS animations and a light/dark theme with custom colors.",
  "keywords": [
    "nexprime",
    "angular",
    "angular21",
    "angular-components",
    "react",
    "nextjs",
    "vue",
    "svelte",
    "web-components",
    "custom-elements",
    "ui-library",
    "ui-kit",
    "component-library",
    "design-system",
    "standalone-components",
    "signals",
    "ssr",
    "dark-mode",
    "theme",
    "forms",
    "rich-text-editor",
    "wysiwyg",
    "quill",
    "data-table",
    "tree-table",
    "charts",
    "dialog",
    "menu",
    "chat",
    "onboarding",
    "product-tour",
    "icons",
    "lucide",
    "animations",
    "lottie",
    "background-effects",
    "particles",
    "confetti"
  ],
  "license": "MIT",
  "homepage": "https://nexprime-dev.vercel.app/",
  "peerDependencies": {
    "@angular/cdk": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@angular/cdk": {
      "optional": true
    },
    "@angular/common": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "@angular/forms": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "lottie-web": "^5.13.0",
    "quill": "^2.0.3",
    "tslib": "^2.3.0"
  },
  "sideEffects": [
    "./elements/*",
    "*.css"
  ],
  "exports": {
    "./styles/*": "./styles/*",
    "./icons/*": "./icons/*",
    "./lottie/*": "./lottie/*",
    "./elements": {
      "types": "./elements/nexprime.d.ts",
      "default": "./elements/nexprime.js"
    },
    "./elements/*": "./elements/*",
    "./react": {
      "types": "./react/index.d.ts",
      "default": "./react/index.js"
    }
  }
}
